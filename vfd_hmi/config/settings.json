{
  "system": {
    "app_name": "DLP KUMAR - VFD HMI",
    "version": "1.1.0",
    "simulation_mode": true,
    "resolution": {
      "width": 800,
      "height": 480
    },
    "update_interval_ms": 100,
    "fullscreen": false
  },
  "communication": {
    "interface": "RS485",
    "protocol": "Modbus RTU",
    "port": "COM3",
    "port_linux": "/dev/ttyUSB0",
    "baudrate": 9600,
    "parity": "N",
    "databits": 8,
    "stopbits": 1,
    "slave_id": 1,
    "timeout_sec": 1.0,
    "retry_attempts": 3
  },
  "safety_limits": {
    "max_frequency_hz": 60.0,
    "min_frequency_hz": 0.0,
    "max_current_a": 15.0,
    "max_temperature_c": 75.0,
    "max_voltage_v": 450.0
  },
  "display": {
    "brightness_percent": 85,
    "theme": "industrial_dark"
  }
}
